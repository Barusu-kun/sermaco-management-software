# ── Variables pour docker-compose ──
DB_NAME=planning_transport
DB_USER=app_user
DB_PASSWORD=change_me_secure_password

JWT_SECRET=change_me_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=24h

# Origines autorisées (CORS) — inclure les hôtes web + mobile
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:5174

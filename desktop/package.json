{
  "name": "planning-transport-desktop",
  "version": "2.1.0",
  "description": "Client Dispatch Windows (Electron) — Planning Transport",
  "main": "main.js",
  "author": "Planning Transport",
  "scripts": {
    "build:renderer": "cross-env VITE_ELECTRON=1 npm --prefix ../web run build && node scripts/copy-renderer.js",
    "start": "npm run build:renderer && electron .",
    "dev": "electron .",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:portable": "npm run build:renderer && electron-builder --win portable"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.planningtransport.dispatch",
    "productName": "Planning Transport Dispatch",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.html",
      "renderer/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Planning-Transport-Dispatch-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Planning Transport Dispatch"
    }
  }
}

# ── Base de données ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=planning_transport
DB_USER=app_user
DB_PASSWORD=change_me_secure_password
DATABASE_URL=postgresql://app_user:change_me_secure_password@localhost:5432/planning_transport?schema=public

# ── JWT ──
JWT_SECRET=change_me_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRES_IN=24h

# ── Serveur ──
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ── CORS (origines autorisées, séparées par des virgules) ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Logs ──
LOG_LEVEL=info
